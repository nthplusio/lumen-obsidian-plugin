{
	"name": "@lumen/obsidian-plugin",
	"version": "1.8.2",
	"description": "Your vault, illuminated — semantic search powered by Lumen",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"check:help": "node scripts/check-help-coverage.mjs",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^22.0.0",
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@vitest/coverage-v8": "^2.1.8",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.8.3",
		"vitest": "^2.1.8"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
