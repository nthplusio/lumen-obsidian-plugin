{
	"name": "@lumen/obsidian-plugin",
	"version": "1.3.0",
	"description": "Your vault, illuminated — semantic search powered by Lumen",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^2.1.8",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.8.3",
		"vitest": "^2.1.8"
	}
}
